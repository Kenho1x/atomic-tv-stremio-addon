
{
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api/manifest/manifest/manifest"
    },
    {
      "source": "/catalog/:type/:id.json",
      "destination": "/api/catalog/:type/:id"
    },
    {
      "source": "/meta/:type/:id.json",
      "destination": "/api/meta/:type/:id"
    }
  ]
}
